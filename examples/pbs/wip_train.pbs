#!/bin/bash -l
#PBS -A SSL-SULI2026
#PBS -l select=1:system=polaris
#PBS -q capacity
#PBS -l walltime=40:00:00
#PBS -l filesystems=home:eagle
#PBS -j oe
#PBS -N radar_dino_wip_tok

set -euo pipefail

module use /soft/modulefiles
module load conda
conda activate

REPO_DIR="$HOME/radar_dino_wip"
DATA_DIR="/eagle/SSL-SULI2026/dwefer/gridnc_gt10pct"
OUT_DIR="/eagle/SSL-SULI2026/dwefer/radar_train_wip_tokenized"
TRAIN_SCRIPT="$REPO_DIR/radar_dino_training.py"

NPROC_PER_NODE=4
PATCH_SIZE=10
BATCH_SIZE_PER_GPU=1
NUM_WORKERS=2
GLOBAL_CROP_SIZE_KM=300
LOCAL_CROP_SIZE_KM=100
GRID_SPACING_KM=1.0
LOCAL_CROPS_NUMBER=4
CHANNEL_NAN_PROB=1.0

mkdir -p "$OUT_DIR/model"
mkdir -p "$OUT_DIR/logs"

exec > >(tee -a "$OUT_DIR/logs/${PBS_JOBID:-radar_dino_wip_tokenized}.log") 2>&1

[[ -d "$REPO_DIR" ]] || { echo "Missing WIP repo directory: $REPO_DIR" >&2; exit 1; }
[[ -d "$DATA_DIR" ]] || { echo "Missing data directory: $DATA_DIR" >&2; exit 1; }
[[ -f "$TRAIN_SCRIPT" ]] || { echo "Missing training script: $TRAIN_SCRIPT" >&2; exit 1; }

cd "$REPO_DIR"

# Guard against accidentally launching the main-branch tokenizer.
grep -q "field_embed" vision_transformer.py || {
  echo "WIP field-token embedding not found in vision_transformer.py" >&2
  exit 1
}
grep -q "mask_random_student_channels" radar_dino_training.py || {
  echo "WIP student channel masking not found in radar_dino_training.py" >&2
  exit 1
}

echo "Job started: $(date)"
echo "PBS job id: ${PBS_JOBID:-unknown}"
echo "Host: $(hostname)"
echo "Repo: $REPO_DIR"
echo "Repo state:"
git status --short --branch
git rev-parse HEAD
echo "Data: $DATA_DIR"
echo "Output: $OUT_DIR"
echo "Training script: $TRAIN_SCRIPT"
echo "Patch size: $PATCH_SIZE"
echo "Batch size per GPU: $BATCH_SIZE_PER_GPU"
echo "Global crop km: $GLOBAL_CROP_SIZE_KM"
echo "Local crop km: $LOCAL_CROP_SIZE_KM"
echo "Student channel mask probability: $CHANNEL_NAN_PROB"

echo "Python:"
which python
python --version

echo "PyTorch:"
python -c "import torch; print(torch.__version__); print(torch.cuda.is_available()); print(torch.cuda.device_count())"

echo "NetCDF symlink/file count:"
find -L "$DATA_DIR" -type f -name "*.nc" | wc -l

echo "Estimated WIP token counts:"
python -c "p=$PATCH_SIZE; fields=5; g=int(round($GLOBAL_CROP_SIZE_KM / $GRID_SPACING_KM)); l=int(round($LOCAL_CROP_SIZE_KM / $GRID_SPACING_KM)); g=(g//p)*p; l=(l//p)*p; print(f'global crop pixels={g}, tokens per sample={fields*(g//p)*(g//p)}'); print(f'local crop pixels={l}, tokens per sample={fields*(l//p)*(l//p)}')"

torchrun \
  --standalone \
  --nnodes=1 \
  --nproc_per_node="$NPROC_PER_NODE" \
  "$TRAIN_SCRIPT" \
  --arch vit_small \
  --patch_size "$PATCH_SIZE" \
  --epochs 100 \
  --batch_size_per_gpu "$BATCH_SIZE_PER_GPU" \
  --num_workers "$NUM_WORKERS" \
  --data_path "$DATA_DIR" \
  --output_dir "$OUT_DIR/model" \
  --saveckp_freq 1 \
  --radar_fields reflectivity specific_differential_phase differential_reflectivity cross_correlation_ratio spectrum_width \
  --in_chans 5 \
  --z_level 2000.0 \
  --radar_nan_fill -1.0 \
  --global_crop_size_km "$GLOBAL_CROP_SIZE_KM" \
  --local_crop_size_km "$LOCAL_CROP_SIZE_KM" \
  --grid_spacing_km "$GRID_SPACING_KM" \
  --local_crops_number "$LOCAL_CROPS_NUMBER" \
  --channel_nan_prob "$CHANNEL_NAN_PROB" \
  --use_fp16 true

echo "Job finished: $(date)"
