#!/bin/bash -l
#PBS -A SSL-SULI2026
#PBS -l select=1:system=polaris
#PBS -q capacity
#PBS -l walltime=40:00:00
#PBS -l filesystems=home:eagle
#PBS -j oe
#PBS -k doe
#PBS -N rdino_train

set -euo pipefail

module use /soft/modulefiles
module load conda
conda activate

USER_NAME="${USER:-$(id -un)}"
EAGLE_USER_DIR="/eagle/SSL-SULI2026/$USER_NAME"
REPO_DIR="${RADAR_DINO_REPO_DIR:-$HOME/radar_dino}"
DATA_DIR="${RADAR_DINO_DATA_DIR:-$EAGLE_USER_DIR/gridnc_gt10pct}"
OUT_DIR="${RADAR_DINO_RUN_DIR:-$EAGLE_USER_DIR/radar_train_fieldtoken}"
EXPECTED_BRANCH="${RADAR_DINO_BRANCH:-main}"
TRAIN_SCRIPT="$REPO_DIR/radar_dino_training.py"

NPROC_PER_NODE=4
PATCH_SIZE=10
BATCH_SIZE_PER_GPU=1
NUM_WORKERS=2
GLOBAL_CROP_SIZE_KM=300
LOCAL_CROP_SIZE_KM=100
GRID_SPACING_KM=1.0
LOCAL_CROPS_NUMBER=4
CHANNEL_NAN_PROB=1.0

mkdir -p "$OUT_DIR/model" "$OUT_DIR/logs"
exec > >(tee -a "$OUT_DIR/logs/${PBS_JOBID:-rdino_train}.log") 2>&1

fail() {
  echo "ERROR: $*" >&2
  exit 1
}

[[ -d "$REPO_DIR/.git" ]] || fail "Missing main repository checkout: $REPO_DIR"
[[ -d "$DATA_DIR" ]] || fail "Missing data directory: $DATA_DIR"
[[ -f "$TRAIN_SCRIPT" ]] || fail "Missing training script: $TRAIN_SCRIPT"

cd "$REPO_DIR"
CURRENT_BRANCH="$(git branch --show-current)"
[[ "$CURRENT_BRANCH" == "$EXPECTED_BRANCH" ]] || fail \
  "Expected branch '$EXPECTED_BRANCH', found '${CURRENT_BRANCH:-detached HEAD}' in $REPO_DIR"
git grep -q "field_embed" -- vision_transformer.py || fail \
  "Field-token embedding is missing from vision_transformer.py"
git grep -q "mask_random_student_channels" -- radar_dino_training.py || fail \
  "Asymmetric student field masking is missing from radar_dino_training.py"
command -v torchrun >/dev/null || fail "torchrun is not available in the active conda environment"
python -c "import PIL, torch, torchvision, xarray" || fail "Required Python packages are missing"
python -c "import importlib.util as u; assert u.find_spec('netCDF4') or u.find_spec('h5netcdf'), 'Install netCDF4 or h5netcdf'" || fail "No xarray NetCDF backend is installed"
python -c "import torch; count=torch.cuda.device_count(); assert count >= $NPROC_PER_NODE, f'Expected at least $NPROC_PER_NODE GPUs, found {count}'" || fail "GPU validation failed"

NC_COUNT="$(find -L "$DATA_DIR" -type f -name '*.nc' | wc -l)"
(( NC_COUNT > 0 )) || fail "Found no NetCDF files under $DATA_DIR"

echo "Job started: $(date)"
echo "PBS job id: ${PBS_JOBID:-unknown}"
echo "Host: $(hostname)"
echo "Repository: $REPO_DIR"
echo "Branch: $CURRENT_BRANCH"
echo "Commit: $(git rev-parse HEAD)"
git status --short --branch
echo "Data: $DATA_DIR ($NC_COUNT NetCDF files)"
echo "Output: $OUT_DIR"
echo "Training script: $TRAIN_SCRIPT"
echo "Python: $(command -v python)"
python --version
python -c "import torch; print(f'PyTorch: {torch.__version__}'); print(f'CUDA available: {torch.cuda.is_available()}'); print(f'GPU count: {torch.cuda.device_count()}')"
echo "Patch size: $PATCH_SIZE"
echo "Batch size per GPU: $BATCH_SIZE_PER_GPU"
echo "Global crop km: $GLOBAL_CROP_SIZE_KM"
echo "Local crop km: $LOCAL_CROP_SIZE_KM"
echo "Student field-mask probability: $CHANNEL_NAN_PROB"
python -c "p=$PATCH_SIZE; fields=5; g=int(round($GLOBAL_CROP_SIZE_KM / $GRID_SPACING_KM)); l=int(round($LOCAL_CROP_SIZE_KM / $GRID_SPACING_KM)); g=(g//p)*p; l=(l//p)*p; print(f'Global crop cells={g}, field-patch tokens={fields*(g//p)*(g//p)}'); print(f'Local crop cells={l}, field-patch tokens={fields*(l//p)*(l//p)}')"

torchrun \
  --standalone \
  --nnodes=1 \
  --nproc_per_node="$NPROC_PER_NODE" \
  "$TRAIN_SCRIPT" \
  --arch vit_small \
  --patch_size "$PATCH_SIZE" \
  --epochs 100 \
  --batch_size_per_gpu "$BATCH_SIZE_PER_GPU" \
  --num_workers "$NUM_WORKERS" \
  --data_path "$DATA_DIR" \
  --output_dir "$OUT_DIR/model" \
  --saveckp_freq 1 \
  --radar_fields reflectivity specific_differential_phase differential_reflectivity cross_correlation_ratio spectrum_width \
  --in_chans 5 \
  --z_level 2000.0 \
  --radar_nan_fill -1.0 \
  --global_crop_size_km "$GLOBAL_CROP_SIZE_KM" \
  --local_crop_size_km "$LOCAL_CROP_SIZE_KM" \
  --grid_spacing_km "$GRID_SPACING_KM" \
  --local_crops_number "$LOCAL_CROPS_NUMBER" \
  --channel_nan_prob "$CHANNEL_NAN_PROB" \
  --use_fp16 true

echo "Job finished: $(date)"
