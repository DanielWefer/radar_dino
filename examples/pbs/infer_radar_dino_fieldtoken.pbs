#!/bin/bash -l
#PBS -A SSL-SULI2026
#PBS -l select=1:system=polaris
#PBS -q preemptable
#PBS -l walltime=2:00:00
#PBS -l filesystems=home:eagle
#PBS -j oe
#PBS -k doe
#PBS -r y
#PBS -N rdino_infer

set -euo pipefail

module use /soft/modulefiles
module load conda
conda activate

USER_NAME="${USER:-$(id -un)}"
EAGLE_USER_DIR="/eagle/SSL-SULI2026/$USER_NAME"
REPO_DIR="${RADAR_DINO_REPO_DIR:-$HOME/radar_dino}"
DATA_DIR="${RADAR_DINO_DATA_DIR:-$EAGLE_USER_DIR/gridnc_gt10pct}"
MODEL_PATH="${RADAR_DINO_MODEL_PATH:-$EAGLE_USER_DIR/radar_train_fieldtoken/model/checkpoint.pth}"
OUT_DIR="${RADAR_DINO_FEATURE_DIR:-$EAGLE_USER_DIR/radar/features_fieldtoken}"
EXPECTED_BRANCH="${RADAR_DINO_BRANCH:-main}"
INFER_SCRIPT="$REPO_DIR/radar_dino_inference.py"

NPROC_PER_NODE=4
PATCH_SIZE=10
BATCH_SIZE_PER_GPU=1
NUM_WORKERS=4
IMAGE_SIZE=300
MAX_ATTENTION_PLOTS="${RADAR_DINO_MAX_ATTENTION_PLOTS:-20}"

mkdir -p "$OUT_DIR/logs"
exec > >(tee -a "$OUT_DIR/logs/${PBS_JOBID:-rdino_infer}.log") 2>&1

fail() {
  echo "ERROR: $*" >&2
  exit 1
}

[[ -d "$REPO_DIR/.git" ]] || fail "Missing main repository checkout: $REPO_DIR"
[[ -d "$DATA_DIR" ]] || fail "Missing data directory: $DATA_DIR"
[[ -f "$MODEL_PATH" ]] || fail "Missing field-token checkpoint: $MODEL_PATH"
[[ -f "$INFER_SCRIPT" ]] || fail "Missing inference script: $INFER_SCRIPT"

cd "$REPO_DIR"
CURRENT_BRANCH="$(git branch --show-current)"
[[ "$CURRENT_BRANCH" == "$EXPECTED_BRANCH" ]] || fail \
  "Expected branch '$EXPECTED_BRANCH', found '${CURRENT_BRANCH:-detached HEAD}' in $REPO_DIR"
git grep -q "field_embed" -- vision_transformer.py || fail \
  "Field-token embedding is missing from vision_transformer.py"
command -v torchrun >/dev/null || fail "torchrun is not available in the active conda environment"
python -c "import matplotlib, PIL, torch, torchvision, xarray" || fail "Required Python packages are missing"
python -c "import importlib.util as u; assert u.find_spec('netCDF4') or u.find_spec('h5netcdf'), 'Install netCDF4 or h5netcdf'" || fail "No xarray NetCDF backend is installed"
python -c "import torch; count=torch.cuda.device_count(); assert count >= $NPROC_PER_NODE, f'Expected at least $NPROC_PER_NODE GPUs, found {count}'" || fail "GPU validation failed"

NC_COUNT="$(find -L "$DATA_DIR" -type f -name '*.nc' | wc -l)"
(( NC_COUNT > 0 )) || fail "Found no NetCDF files under $DATA_DIR"

echo "Job started: $(date)"
echo "PBS job id: ${PBS_JOBID:-unknown}"
echo "Host: $(hostname)"
echo "Repository: $REPO_DIR"
echo "Branch: $CURRENT_BRANCH"
echo "Commit: $(git rev-parse HEAD)"
git status --short --branch
echo "Data: $DATA_DIR ($NC_COUNT NetCDF files)"
echo "Model: $MODEL_PATH"
echo "Output: $OUT_DIR"
echo "Inference script: $INFER_SCRIPT"
echo "Python: $(command -v python)"
python --version
python -c "import torch; print(f'PyTorch: {torch.__version__}'); print(f'CUDA available: {torch.cuda.is_available()}'); print(f'GPU count: {torch.cuda.device_count()}')"
echo "Patch size: $PATCH_SIZE"
echo "Batch size per GPU: $BATCH_SIZE_PER_GPU"
echo "Image size: $IMAGE_SIZE"
echo "Maximum attention plots: $MAX_ATTENTION_PLOTS"
python -c "p=$PATCH_SIZE; fields=5; s=($IMAGE_SIZE//p)*p; print(f'Image cells={s}, field-patch tokens={fields*(s//p)*(s//p)}')"

torchrun \
  --standalone \
  --nnodes=1 \
  --nproc_per_node="$NPROC_PER_NODE" \
  "$INFER_SCRIPT" \
  --arch vit_small \
  --patch_size "$PATCH_SIZE" \
  --data_path "$DATA_DIR" \
  --pretrained_weights "$MODEL_PATH" \
  --checkpoint_key teacher \
  --dump_features "$OUT_DIR" \
  --batch_size_per_gpu "$BATCH_SIZE_PER_GPU" \
  --num_workers "$NUM_WORKERS" \
  --image_size "$IMAGE_SIZE" \
  --radar_fields reflectivity specific_differential_phase differential_reflectivity cross_correlation_ratio spectrum_width \
  --in_chans 5 \
  --z_level 2000.0 \
  --radar_nan_fill -1.0 \
  --plot_attention_overlays true \
  --max_attention_plots "$MAX_ATTENTION_PLOTS"

echo "Job finished: $(date)"
